{
	"name": "live",
	"version": "0.0.1",
	"devDependencies": {
		"@faker-js/faker": "^10.5.0",
		"@prisma/adapter-libsql": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/bun": "^1.4.2",
		"prisma": "^7.8.0",
		"prisma-markdown": "^4.0.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.7.6",
		"vite": "^8.0.7"
	},
	"private": true,
	"scripts": {
		"prisma:nuke": "rm -rf ./src/generated/prisma && rm -rf ./prisma/migrations && rm ./prisma/app.db",
		"schema": "bunx prisma generate",
		"apply": "bunx prisma migrate dev --name init",
		"dummy": "bun run prisma/seed.ts",
		"dev": "vite dev",
		"test": "bun test",
		"check": "tsc -b && svelte-check --tsconfig ./tsconfig.json && vite build",
		"upstream": "vite build && rm -rf ../hh200/min && cp -r build ../hh200/min",
		"prepare": "svelte-kit sync || echo ''"
	},
	"type": "module"
}
