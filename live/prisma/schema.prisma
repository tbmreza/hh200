model MetricWindow {
  id        Int     @id @default(autoincrement())
  run_id    Int
  // id          String   @id @default(cuid())
  // runId       String
  endpoint    String
  start DateTime
  end   DateTime

  count       Int
  fail_count   Int
  min_latency  Float
  max_latency  Float
  avg_latency  Float
  rps         Float

  run         Run      @relation(fields: [run_id], references: [id])

  // @@index([run_id, endpoint])
  @@map("metric_windows")
}
