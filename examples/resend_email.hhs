# Send an email with an image attachment through Resend.
#
#   HH200_VAR_RESEND_API_KEY=re_... hh200 examples/resend_email.hhs
#
# photo.png is read from this script's directory and sent base64-encoded.
# The API key comes from outside the script (--var or HH200_VAR_*); if it is
# missing, hh200 stops before sending anything.
POST https://api.resend.com/emails
Authorization: Bearer {{RESEND_API_KEY}}
Content-Type: application/json
[Vars]
IMG_BASE64: base64-file,photo.png
{
  "from": "sender@example.com",
  "to": ["recipient@example.com"],
  "subject": "Email with local image",
  "html": "<p>See attached image.</p>",
  "attachments": [ { "filename": "photo.png", "content": "{{IMG_BASE64}}" } ]
}
HTTP 200
[Captures]
EMAIL_ID: {{jsonpath "$.id"}}
